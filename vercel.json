{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://sync-ranking.alcastro-batucan.workers.dev/auth/:path*"
    },
    {
      "source": "/api/attendance/:path*",
      "destination": "https://sync-ranking.alcastro-batucan.workers.dev/api/attendance/:path*"
    }
  ],
  "headers": [
    {
      "source": "/auth/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    },
    {
      "source": "/api/attendance/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    }
  ]
}
